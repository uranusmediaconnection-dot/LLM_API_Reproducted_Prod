DATABASE_URL=postgresql://postgres:postgres@localhost:5432/freellmapi

# Optional provider credentials. Add real keys in your local environment or deployment secrets.
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Web tools (search + scrape context injection for chat, /v1/tools/* endpoints).
# Without keys the chain falls back to keyless DuckDuckGo search and plain-fetch scraping.
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
# auto (default) = enhance chat requests that contain a URL or search intent; off = disable globally.
WEB_TOOLS_MODE=auto
